#!/usr/bin/env bash
# review-package - Generate a review package for a plan
# Usage: review-package PLAN_FILE BASE HEAD

set -euo pipefail

PLAN_FILE="${1:?PLAN_FILE required}"
BASE="${2:?BASE required}"
HEAD="${3:?HEAD required}"

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")
PLAN_BASENAME=$(basename "$PLAN_FILE" .md)
WORKSPACE="$REPO_ROOT/.superpowers/sdd/$PLAN_BASENAME"
PACKAGE="$WORKSPACE/review-package-$(date +%s).md"

{
  echo "# Review Package"
  echo ""
  echo "Plan: $PLAN_FILE"
  echo "Base: $BASE"
  echo "Head: $HEAD"
  echo ""
  echo "## Commit List"
  git log --oneline "$BASE..$HEAD" 2>/dev/null || echo "(no commits in range)"
  echo ""
  echo "## Diff Stat"
  git diff --stat "$BASE" "$HEAD" 2>/dev/null || echo "(no diff)"
  echo ""
  echo "## Full Diff"
  git diff -U10 "$BASE" "$HEAD" 2>/dev/null || echo "(no diff)"
} > "$PACKAGE"

echo "$PACKAGE"
