#!/usr/bin/env bash
# sdd-workspace - Print the plan's git-ignored workspace directory
# Usage: sdd-workspace PLAN_FILE

set -euo pipefail

PLAN_FILE="${1:?PLAN_FILE required}"

if [ ! -f "$PLAN_FILE" ]; then
  echo "Plan file not found: $PLAN_FILE" >&2
  exit 1
fi

PLAN_BASENAME=$(basename "$PLAN_FILE" .md)
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")
WORKSPACE="$REPO_ROOT/.superpowers/sdd/$PLAN_BASENAME"

mkdir -p "$WORKSPACE"

echo "$WORKSPACE"
